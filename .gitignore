*.log

# Local app data
imports/*
!imports/.gitkeep
processed/**
!processed/thumbs/
!processed/thumbs/.gitkeep
exports/*
!exports/.gitkeep
backend/exports/*
!backend/exports/.gitkeep
# Ignore everything under data/ (DBs, COLMAP workspaces, datasets, run logs like
# vram_full_run.csv) — only the directory placeholder is tracked.
data/*
!data/.gitkeep

# Frontend
node_modules/

# Git worktrees
.worktrees/

# Internal planning/workspace files
.internal/
internal/

# AI skill installs (local tooling, never committed)
.agents/
