# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
dist-installer/
build/
*.egg-info/
.venv*
venv

# Local secrets and machine config
.env
.env.*
.creds.json
*.key
# Share link signing key (generated at first share-link creation)
.share_signing_key
*.pem

# Drone media and flight data
*.MP4
*.mp4
*.MOV
*.mov
*.SRT
*.srt
*.JPG_original
*.jpg_original
FlightRecord_*.txt
extracted*/
*_geotagged/
frame_geotags.csv
exiftool_geotags.args

# WebODM/Desktop install data
resources/app/data/
resources/app/logs/
logs/
resources/app/apps/
*.log

# Local app data
imports/*
!imports/.gitkeep
processed/**
!processed/thumbs/
!processed/thumbs/.gitkeep
exports/*
!exports/.gitkeep
backend/exports/*
!backend/exports/.gitkeep
# Ignore everything under data/ (DBs, COLMAP workspaces, datasets, run logs like
# vram_full_run.csv) — only the directory placeholder is tracked.
data/*
!data/.gitkeep
# Headless pipeline run output (dvg-pipeline --output-root default).
pipeline_output/

# Frontend
node_modules/

# Git worktrees
.worktrees/

# Internal planning/workspace files
.internal/
internal/

# AI skill installs and agent tooling (local, never committed). These previously
# lived only in .git/info/exclude, which is not cloned — so every fresh clone saw
# them as untracked noise.
.agents/
.claude/
.superpowers/
docs/superpowers/
skills-lock.json

# Dev dashboard (internal tool, not part of the public project)
dashboard/

# Editor config (keep local)
.vscode/

# OS files
.DS_Store
Thumbs.db
